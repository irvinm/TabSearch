{
  "webext-lint-check": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c .agents\\lint.bat",
            "timeout": 25
          }
        ]
      }
    ]
  }
}
